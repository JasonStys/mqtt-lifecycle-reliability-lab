{
  "name": "mqtt-lifecycle-reliability-lab",
  "version": "1.1.0",
  "description": "Deterministic MQTT lifecycle and reliability laboratory for edge telemetry systems.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "benchmark": "tsx src/benchmark.ts",
    "build": "tsc --noEmit && vite build",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "scenario": "tsx src/cli.ts",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run tests/unit",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm format:check && pnpm lint && pnpm test && pnpm test:integration && pnpm build && pnpm scenario && pnpm recovery && pnpm benchmark && pnpm symbols:check && pnpm audit",
    "recovery": "tsx src/recovery-cli.ts",
    "build:native": "node scripts/build-native.mjs",
    "test:native-boundaries": "npm --prefix desktop test",
    "test:native-app": "node --import tsx scripts/test-native-app.mjs",
    "symbols": "node scripts/generate-code-map.mjs",
    "symbols:check": "node scripts/generate-code-map.mjs --check",
    "test:native-notices": "node --test tests/native/locked-notice.test.mjs",
    "audit": "pnpm audit --audit-level moderate"
  },
  "dependencies": {
    "mqtt": "5.16.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
